{
  "name": "@pactpal/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node build.js",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "env:check": "tsx src/check-env.ts",
    "migrate": "tsx src/migrate.ts",
    "sandbox:check": "tsx src/sandbox-check.ts",
    "sandbox:invoice": "tsx src/sandbox-invoice.ts",
    "sandbox:disputes": "tsx src/sandbox-disputes.ts",
    "sandbox:respond": "tsx src/sandbox-respond.ts",
    "sandbox:webhook": "tsx src/sandbox-webhook.ts",
    "seed:sandbox": "tsx src/seed-sandbox.ts",
    "ai:check": "tsx src/ai-check.ts",
    "eval:injection": "tsx src/injection-check.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/helmet": "^13.2.0",
    "@fastify/static": "^10.1.8",
    "@pactpal/ai": "workspace:*",
    "@pactpal/council": "workspace:*",
    "@pactpal/db": "workspace:*",
    "@pactpal/ledger": "workspace:*",
    "@pactpal/net": "workspace:*",
    "@pactpal/paypal": "workspace:*",
    "@pactpal/scope-draft": "workspace:*",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "~0.25.12",
    "tsx": "^4.19.2"
  }
}
