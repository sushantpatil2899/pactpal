# Copy to .env and fill in locally. Never commit real values.

# Server
PORT=3000

# PayPal sandbox: seller app ("Default Application")
PAYPAL_SELLER_CLIENT_ID=
PAYPAL_SELLER_CLIENT_SECRET=

# PayPal sandbox: buyer business app ("Dispute Buyer App"), used by the test lab to open disputes
PAYPAL_BUYER_BIZ_CLIENT_ID=
PAYPAL_BUYER_BIZ_CLIENT_SECRET=

# PayPal sandbox: platform app (Partner Referrals / "Connect with PayPal")
PAYPAL_PLATFORM_CLIENT_ID=
PAYPAL_PLATFORM_CLIENT_SECRET=

# Webhook id from the developer dashboard, used to verify webhook signatures
PAYPAL_WEBHOOK_ID=

# Database
DATABASE_URL=

# LLM council: one key per registered provider
GROQ_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
