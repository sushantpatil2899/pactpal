# Copy to .env and fill in locally. Never commit real values.
# Run `pnpm env:check` to see which settings are set and which features are ready (values are never shown).
# Find PayPal values at developer.paypal.com > Apps & Credentials, with the Sandbox toggle on.
# Set an app's client id and secret together, or leave both empty.

# Server
PORT=3000
# How many proxies stand in front of the server (0 to 3); not a secret. Render uses 2 (set in
# render.yaml). Leave empty locally: visitors' IP addresses are then not recorded.
TRUST_PROXY_HOPS=

# PayPal sandbox: seller app ("Default Application"), the REST app of the sandbox business account that sells
PAYPAL_SELLER_CLIENT_ID=
PAYPAL_SELLER_CLIENT_SECRET=

# PayPal sandbox: buyer business app ("Dispute Buyer App"), the REST app of the second sandbox business
# account that acts as the buyer; used by the test setup script to pay and open disputes
PAYPAL_BUYER_BIZ_CLIENT_ID=
PAYPAL_BUYER_BIZ_CLIENT_SECRET=

# PayPal sandbox: platform app (Partner Referrals / "Connect with PayPal")
PAYPAL_PLATFORM_CLIENT_ID=
PAYPAL_PLATFORM_CLIENT_SECRET=

# Webhook id shown on the seller app's page, used to verify webhook signatures
PAYPAL_WEBHOOK_ID=

# The site's own address (no trailing path), used to build PayPal's sign-in return address.
# It must match the Return URL registered for the app, plus /auth/paypal/callback.
PUBLIC_BASE_URL=http://localhost:3000

# Database: a postgres:// address. On Render it is filled in from the database by render.yaml.
# Locally, point it at any Postgres you run, then `pnpm migrate`. Tests need no database.
DATABASE_URL=
# Optional: set to a throwaway Postgres to also run the real-Postgres integration test (it empties that database).
TEST_DATABASE_URL=

# AI models: one key per host, all called over the internet (nothing runs on our server).
# Models take part only when their key is set. `pnpm ai:check` tests each one with a tiny question.
# Gemini: Google AI Studio. Groq hosts the Qwen and gpt-oss models. Mistral: Mistral's own API.
# OpenRouter: only its free models are used; give its key a small dollar limit as a safety cap.
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=

# Email through Resend (resend.com). Both are needed; without them no email is sent (links can be
# copied by hand). The key: Resend > API keys, "Sending access" only, for your verified domain.
# EMAIL_FROM: an address on that domain; Render uses receipts@updates.pact-pal.app ("PactPal" is added as the name).
RESEND_API_KEY=
EMAIL_FROM=

# Email forwarding (Resend Inbound). All three are needed; without them forwarding is off.
# RESEND_INBOUND_API_KEY: a key that can read received emails ("Full access" in Resend).
# RESEND_WEBHOOK_SECRET: the signing secret (whsec_...) of the webhook for email.received.
# INBOUND_DOMAIN: the receiving domain; Render uses in.pact-pal.app.
RESEND_INBOUND_API_KEY=
RESEND_WEBHOOK_SECRET=
INBOUND_DOMAIN=

# Dispute checks (5a) on Render Workflows: a Render API key (Account settings, API Keys; it can act
# on the whole Render account, so keep it secret) and the Workflow task to start, as
# <workflow service>/<task>. Without both, "Check now" runs the check inside the server and nothing
# checks on a schedule.
RENDER_API_KEY=
DISPUTE_TASK_SLUG=

# Sellers' own PayPal apps (6h): the key that encrypts their app secrets in the database. 32 random
# bytes in base64; make one with: openssl rand -base64 32. Keep a copy: losing it means every
# seller must link again. Without it, linking an app is off and everything else works.
SELLER_KEYS_ENCRYPTION_KEY=

# Insights page (7R): the AG Grid / AG Studio licence key. It is read when the web app is built
# and, as AG intends, ships inside the page's code. Without it Insights runs in AG's trial mode.
VITE_AG_LICENCE_KEY=
