  "cards": [
    {
      "dot": "cyan",
      "title": "One Blueprint",
      "items": [
        "Every service is defined in render.yaml",
        "Each push to dev redeploys all services",
        "Migrations run before deploy; a failure keeps the old version"
      ]
    },
    {
      "dot": "violet",
      "title": "Workflows",
      "items": [
        "Each AI model call is its own run, so a council's models answer side by side",
        "A slow or failing model never blocks the others",
        "Retries are set per task in code"
      ]
    },
    {
      "dot": "emerald",
      "title": "Shared and private",
      "items": [
        "Keys live once in the pactpal-shared Environment Group",
        "Postgres and Key Value accept Render's private network only",
        "All tasks read and write pactpal-db"
      ]
    }
  ]
