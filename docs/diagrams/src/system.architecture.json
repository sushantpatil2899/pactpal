    {
      "dot": "violet",
      "title": "AI",
      "items": [
        "High-stakes drafts go to a council of five models",
        "Every AI line cites the chat or the log, or stays blank",
        "Nothing goes to a buyer or to PayPal until the seller confirms"
      ]
    },
    {
      "dot": "emerald",
      "title": "Evidence",
      "items": [
        "Every message, signature, payment, delivery and approval is logged",
        "Each entry holds the fingerprint of the one before",
        "Receipts and evidence packets are PDFs built from the log"
      ]
    }
